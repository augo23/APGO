config apgo 'main'
	option enabled '0'
	# Same network name + PSK on every device on your mesh.
	option network_name ''
	option psk ''
	option friendly_name 'openwrt-router'
	option overlay_cidr '10.22.55.0/24'
	# Optional: pin this router's overlay IP (blank = derived from its key).
	# Peers give a pinned address to the first node using it; assign it to
	# this router in the admin panel to make it permanent.
	option overlay_address ''
	# How peers' address claims are checked: '' (default) or 'strict'.
	option ip_binding ''
	option udp_listen_port '6969'
	option mtu '1280'
	# Keep the crypto profile identical network-wide.
	option post_quantum '1'
	option pq_auth '1'
	option ipv6 '1'
	# "chacha" (default, fast everywhere) or "aesgcm" (x86 with AES-NI).
	option cipher 'chacha'
	# Route all of this ROUTER's internet traffic via a mesh exit node:
	option use_exit '0'
	option exit_peer ''
	# Make this router an INTERNAL exit node (devices on this network can
	# route their internet through it) — see README "Exit node" for the
	# firewall/NAT side:
	option exit_node '0'
	# Let full VPN fall back to PUBLIC exit nodes when this network has none:
	option use_public_exits '0'
	# PUBLIC exit node: share this router's internet with ANY APGO user
	# (public internet only). Needs the DHT and the public relay; their
	# traffic leaves from this router's IP address.
	option public_exit '0'
	# option public_exit_up_limit '20mbit'
	# option public_exit_down_limit '20mbit'
	# option public_exit_quota '100GB'
	# option public_exit_max_clients '8'
	# Optional HTTPS rendezvous server URLs (space-separated), for networks
	# that block BitTorrent trackers:
	# option rendezvous_servers 'https://rendezvous.example.com'
