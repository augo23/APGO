# Example client config. Copy to /config/client.yaml (or point CLIENT_CONFIG
# at it) and adjust. All nodes in one overlay must share network_name, psk,
# and overlay_cidr.

network_name: "home-lab-overlay"
node_private_key: "/config/node.key"
psk: "base64:r5D9QBcJw5ToR+Aq68aL/eSZzq6Cm7IWkW+T/ozzUaU="

# Overlay subnet. Each node derives its own stable IP inside this range from
# its public key — no per-node addressing needed. Can also be set with the
# OVERLAY_CIDR environment variable (env wins over this file).
overlay_cidr: "10.22.55.0/24"

tun:
  name: "ovl0"
  mtu: 1280
  # address_cidr: "10.22.55.2/24"   # optional: pin this node's IP manually

# Fixed port keeps the NAT mapping stable across restarts. 0 = random.
udp_listen_port: 6969

stun_servers:
  - "stun:stun.l.google.com:19302"
  - "stun:stun1.l.google.com:19302"
  - "stun:global.stun.twilio.com:3478"

announce_only_on_ip_change: false
tracker_list_file: "/config/trackers.txt"
controller_url: ""
min_announce_interval_seconds: 30

# Optional extras:
# trackers:                      # inline tracker URLs (udp:// or http://)
#   - "udp://tracker.opentrackr.org:1337/announce"
# static_peers:                  # known endpoints to dial immediately
#   - "203.0.113.7:6969"
# tracker_mode: "bootstrap"      # or "passive" (announce port 0, poll fast)
# compression: true
# exit_node: true                # BE an internet exit for the mesh (Linux only)
# use_exit: true                 # route ALL internet traffic via an exit (full VPN)
# exit_peer: "10.22.55.7"        # pin ONE exit (overlay IP / name / key); blank = fastest

# Rendezvous (HTTPS discovery) credential, for servers that require one.
# ONE field, two schemes, auto-detected:
#   "user:password"  -> HTTP Basic
#   "sometoken"      -> Bearer token
# Blank/absent = send no credential (open server). Env: RENDEZVOUS_AUTH, or
# RENDEZVOUS_TOKEN, or RENDEZVOUS_USER + RENDEZVOUS_PASSWORD.
# rendezvous_auth: "alice:hunter2"

# NAT keepalive interval (seconds). Default 25 (WireGuard's persistent-
# keepalive value — beats typical ~30s+ NAT UDP timeouts while keeping phone
# peers' radios asleep 2.5x longer than the old 10s default). Lower it for
# extremely aggressive NATs; sessions self-heal after ~3 missed intervals.
# Clamped 5..120.
# keepalive_seconds: 25

# --- Distributed discovery (DHT / Kademlia) ---------------------------------
# The DHT is a THIRD discovery source alongside trackers and rendezvous, and
# the only one that needs no server: two nodes with the same PSK find each
# other with no infrastructure between them. It runs on this client's own UDP
# port, so the NAT mapping it keeps warm is the same one peers punch to.
#
# The lookup key is BLINDED with your PSK — HMAC-SHA1(psk, network_name), not
# SHA-1(network_name) — so nobody who guesses your network name can enumerate
# your members on the public swarm. Rotating the PSK rotates the key.
# dht: false                     # env: DHT=1/0. Default OFF — it shares the
#                                # overlay UDP socket and dials endpoints from
#                                # the public swarm, some of which are junk.
# dht_public_key: false          # announce the PLAIN infohash instead.
#                                # Leave false: true makes your membership
#                                # publicly enumerable by name.

# --- Public relay -----------------------------------------------------------
# Two independent switches:
#
#   use_public_relays  — USE other people's relays when a direct path is
#                        impossible (symmetric NAT, CGNAT). Costs you nothing
#                        and costs them only what THEY agreed to donate.
#   public_relay       — BE a relay for others. Off by default.
#
# A public relay carries full overlay traffic for nodes outside your network.
# It cannot read any of it (the traffic is Noise-encrypted end to end and the
# relay holds no keys) and it cannot join your overlay (it holds no PSK). It
# only pairs nodes that present the same blinded key, so it can never bridge
# two unrelated overlays.
#
# use_public_relays: false       # env: USE_PUBLIC_RELAYS=1/0. Default OFF —
#                                # an open circuit becomes a synthetic 240/4
#                                # route and silently swallows the data plane
#                                # if that circuit is bad. Enable deliberately.
# public_relay: false            # env: PUBLIC_RELAY=1. Default OFF.
#
# What you are willing to give. Rates accept bytes ("5MB", "500kb") or bits as
# ISPs quote them ("20mbit" = 2.5 MB/s), "unlimited" for no cap. Defaults are
# 1MB/s each way — a modest, visible donation rather than a blank cheque.
# relay_up_limit: "1MB"          # env: RELAY_UP_LIMIT
# relay_down_limit: "1MB"        # env: RELAY_DOWN_LIMIT
# relay_per_circuit_limit: "256kb"   # one peer's share, so the first caller
#                                    # cannot claim the whole allowance
# relay_quota: "200GB"           # TOTAL per period; relaying stops when spent
# relay_quota_days: 30           # and resumes when the period rolls over.
#                                # Usage is PERSISTED, so restarting does not
#                                # reset the budget. Blank = no cap.
# relay_max_circuits: 64         # env: RELAY_MAX_CIRCUITS
# relay_max_per_ip: 4            # env: RELAY_MAX_PER_IP
#
# static_relays:                 # skip DHT discovery, use a relay you run
#   - "relay.example.com:6969"   # env: STATIC_RELAYS (comma-separated)
